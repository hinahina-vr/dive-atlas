{
  "version": 8,
  "name": "DIVE ATLAS Okinawa",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    },
    "island-gazetteer": {
      "type": "geojson",
      "data": "./assets/okinawa-island-names.geojson"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#e3e1bc"
      }
    },
    {
      "id": "vegetation",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#a9c99c",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#a2c99a",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "water-main",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#08779e"
      }
    },
    {
      "id": "waterways",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#6eb7c7",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.5,
          16,
          2
        ]
      }
    },
    {
      "id": "country-boundaries",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "paint": {
        "line-color": "#8e926f",
        "line-width": 0.8,
        "line-opacity": 0.6
      },
      "filter": [
        "<=",
        [
          "get",
          "admin_level"
        ],
        4
      ]
    },
    {
      "id": "roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#f9f2da",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.4,
          15,
          2
        ]
      },
      "minzoom": 9,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "motorway",
          "trunk",
          "primary",
          "secondary"
        ],
        true,
        false
      ]
    },
    {
      "id": "minor-roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#f8f1d4",
        "line-width": 0.7,
        "line-opacity": 0.7
      },
      "minzoom": 13
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "paint": {
        "fill-color": "#c1bfa4",
        "fill-opacity": 0.7
      },
      "minzoom": 14
    },
    {
      "id": "country-names",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "paint": {
        "text-color": "#294e50",
        "text-halo-color": "#fff8df",
        "text-halo-width": 1.8
      },
      "minzoom": 1,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "country",
          "state"
        ],
        true,
        false
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:ja"
          ],
          [
            "get",
            "name:nonlatin"
          ],
          [
            "get",
            "name"
          ],
          [
            "get",
            "name:en"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 15,
        "text-padding": 5,
        "text-max-width": 8
      }
    },
    {
      "id": "town-names",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "paint": {
        "text-color": "#294e50",
        "text-halo-color": "#fff8df",
        "text-halo-width": 1.8
      },
      "minzoom": 5,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "city",
          "town",
          "village"
        ],
        true,
        false
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:ja"
          ],
          [
            "get",
            "name:nonlatin"
          ],
          [
            "get",
            "name"
          ],
          [
            "get",
            "name:en"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 13,
        "text-padding": 5,
        "text-max-width": 8
      }
    },
    {
      "id": "neighbourhood-names",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "paint": {
        "text-color": "#4c6261",
        "text-halo-color": "#fff8df",
        "text-halo-width": 1.8
      },
      "minzoom": 12,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "suburb",
          "quarter",
          "neighbourhood",
          "hamlet"
        ],
        true,
        false
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:ja"
          ],
          [
            "get",
            "name:nonlatin"
          ],
          [
            "get",
            "name"
          ],
          [
            "get",
            "name:en"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11,
        "text-padding": 5,
        "text-max-width": 8
      }
    },
    {
      "id": "water-names",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "paint": {
        "text-color": "#e0f4ed",
        "text-halo-color": "#056b8c",
        "text-halo-width": 1.3
      },
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Point"
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:ja"
          ],
          [
            "get",
            "name:nonlatin"
          ],
          [
            "get",
            "name"
          ],
          [
            "get",
            "name:en"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          3,
          12,
          11,
          15
        ],
        "text-letter-spacing": 0.12,
        "text-max-width": 9
      }
    },
    {
      "id": "island-names",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "paint": {
        "text-color": "#193c47",
        "text-halo-color": "#fff8d7",
        "text-halo-width": 2,
        "text-halo-blur": 0.3
      },
      "minzoom": 4,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "island",
          "islet"
        ],
        true,
        false
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:ja"
          ],
          [
            "get",
            "name:nonlatin"
          ],
          [
            "get",
            "name"
          ],
          [
            "get",
            "name:en"
          ]
        ],
        "text-font": [
          "Noto Sans Bold"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          12,
          10,
          15,
          14,
          18
        ],
        "text-offset": [
          0,
          1.3
        ],
        "text-max-width": 9,
        "text-padding": 2,
        "text-allow-overlap": true,
        "text-ignore-placement": true
      }
    },
    {
      "id": "island-local-names",
      "type": "symbol",
      "source": "island-gazetteer",
      "minzoom": 10.7,
      "layout": {
        "text-field": [
          "get",
          "name:ja"
        ],
        "text-font": [
          "Noto Sans Bold"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10.7,
          12,
          13,
          15,
          16,
          18
        ],
        "text-offset": [
          0,
          2.1
        ],
        "text-max-width": 9,
        "text-padding": 3,
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#163b49",
        "text-halo-color": "#fff9df",
        "text-halo-width": 2.1,
        "text-halo-blur": 0.3
      }
    }
  ]
}
